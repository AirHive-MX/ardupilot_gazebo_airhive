    <!-- ##################### -->
    <!--  Lift & Drag Plugins  -->
    <!-- ##################### --> 

    <!-- Plugin for rotor 0 -->
    <plugin filename="ignition-gazebo-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
        <a0>.1</a0>          <!-- -10° -->
        <cla>.1</cla>
        <cda>0.001</cda>
        <cma>0</cma>
        <cp relative_to='rotor_0'>0.08 0 0.003</cp>
        <area>0.005</area>     <!-- algo mayor si hace falta -->
        <air_density>1.225</air_density>
        <forward relative_to='rotor_0'>0 1 0</forward>
        <upward>0 0 1</upward>  <!-- o 0 0 -1 si mediste empuje negativo -->
        <link_name>rotor_0</link_name>
      </plugin>
    <plugin filename="ignition-gazebo-lift-drag-system"
        name="gz::sim::systems::LiftDrag">
