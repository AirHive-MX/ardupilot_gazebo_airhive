    <!-- ################ -->
    <!-- ARDUPILOT PLUGIN -->
    <!-- ################ -->

    <plugin name="ArduPilotPlugin" filename="libArduPilotPlugin.so">
      <!-- Dirección IP y puerto para comunicación -->
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <connectionTimeoutMaxCount>5</connectionTimeoutMaxCount>
      <lock_step>1</lock_step>

      <!-- Conversión de coordenadas -->
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 0 180 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 0</gazeboXYZToNED>

      

      <!-- Sensor IMU -->
